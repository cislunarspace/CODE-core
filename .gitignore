# Rust 构建产物
/target/
# 库项目惯例：Cargo.lock 不入库（构建以 pyproject.toml / uv.lock 为准，
# 本地 cargo 构建会自动生成）。
Cargo.lock

# Python 字节码与缓存（无斜杠模式匹配所有层级）
__pycache__/
*.py[cod]
*$py.class
.Python

# 包构建与分发产物
build/
dist/
*.egg-info/
*.whl
*.tar.gz
.cibuildwheel/

# 虚拟环境与环境文件
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/
conda-env/
conda-meta/
*.conda

# 测试与覆盖率报告
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
test_output/
test-results/
*.log

# IDE、编辑器与操作系统文件
.vscode/
.idea/
.claude/
.cursor/
.cursorrules
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 临时与进程文件
*.tmp
*.temp
*.pid
*.pid.lock
*.seed

# 缓存目录
.cache/
.ruff_cache/

# 编译扩展
*.so
*.dylib
*.dll
# build.rs 生成的 Python ABI 版本文件（构建产物，不入库）
e2m2e/_rust_abi.py

# 文档构建产物（Sphinx）
docs/_build/

# 性能分析
*.prof

# 数据文件（示例/试验产物）
*.mat
*.npy
*.npz
*.pkl
*.pickle
# CR3BP 基线数据集（ADR 0036）：JSON + NPZ 均入仓库、随包分发
!e2m2e/data/catalog_baseline/*.npz

# 笔记本与脚本临时产物
*.ipynb
.ipynb_checkpoints/
temp.py
scripts/*.png
examples/main_*.png

# SPICE 行星星历内核大文件（de430.bsp 超 100MB，经 git-lfs 入库，见 .gitattributes）
# 下载方式（不用 LFS 时可手动下载）：https://naif.jpl.nasa.gov/pub/naif/generic_kernels/spk/planets/
# 本地 CSPICE 库与下载缓存（scripts/download_cspice.py 生成）
# 只忽略仓库根目录的 cspice/（手动解压的 CSPICE 源码包），不动 crates/cspice/
/cspice/
.cspice/
# cspice 运行产生的 Fortran 临时输出
fort.*

# agent/工具会话产物（本地工作文件，不入库）
.mimocode/
.zcode/
.pi/
*.pdb
AGENTS.md
CONTEXT.md
CONTEXT-MAP.md
docs/agents/

# 注：.python-version 故意被跟踪（uv 与 CI 用它钉住 Python 3.13）
