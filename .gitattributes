# 自动检测文本文件并统一换行为 LF
* text=auto eol=lf

# Python
*.py text diff=python
*.pyi text

# Rust
*.rs text diff=rust

# 文档
*.md text
*.rst text
*.txt text

# 配置
*.toml text
*.yaml text
*.yml text
*.json text
*.ini text
*.cfg text
uv.lock text

# Shell 脚本——始终 LF
*.sh text eol=lf

# Windows 批处理——始终 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 笔记本与数据文件——二进制
*.ipynb binary
*.npy binary
*.npz binary
*.pkl binary
*.pickle binary
*.mat binary
*.bsp binary

# 编译产物——二进制
*.so binary
*.dylib binary
*.dll binary
*.pyd binary
*.whl binary

# 图片
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.ico binary

# 字体
*.ttf binary
*.woff binary
*.woff2 binary

# sdist 排除（git archive export-ignore）
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
tests/ export-ignore
docs/ export-ignore
scripts/ export-ignore
CHANGELOG.md export-ignore
kernels/*.bsp filter=lfs diff=lfs merge=lfs -text
